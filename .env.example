# Copy this file to .env.local and adjust if needed.
# .env.local is git-ignored.

# Base URL for your local Ollama server's OpenAI-compatible API.
# Default is correct for a standard local install.
OLLAMA_BASE_URL=http://localhost:11434/v1

# The Ollama model to use. Must be a model you have already pulled via:
#   ollama pull <model>
# Examples: llama3.2, llama3.1, qwen2.5, mistral, phi3
OLLAMA_MODEL=llama3.2
