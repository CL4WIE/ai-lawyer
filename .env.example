# Copy this file to .env.local and adjust if needed.
# .env.local is git-ignored.

# API key for Google Gemini. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# The Gemini chat model to use. gemini-flash-lite-latest is Google's
# always-current alias for the cheapest Flash-Lite model, which avoids
# breaking when a specific dated model (e.g. gemini-2.5-flash-lite) gets
# deprecated for new API keys.
GEMINI_MODEL=gemini-flash-lite-latest

# The Gemini embedding model used for RAG retrieval. Must match whatever
# model/dimensions the ingestion script used to populate the Qdrant
# `labour-laws` collection.
GEMINI_EMBED_MODEL=gemini-embedding-001

# Override only if you need to point at a different OpenAI-compatible
# endpoint. Defaults to Google's Gemini OpenAI-compatible API.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Base URL for the Qdrant vector database used for RAG retrieval.
# Locally this is your local Qdrant container. In production (see
# ../DEPLOY.md) this should be the internal Docker network address,
# e.g. http://qdrant:6333.
QDRANT_BASE_URL=http://localhost:6333

# Required only when Qdrant is deployed with QDRANT__SERVICE__API_KEY set
# (production). Leave unset for local dev, where Qdrant runs without auth.
# QDRANT_API_KEY=

# Postgres connection string used for user accounts and chat history.
# Point this at a local Postgres instance for dev (e.g. `docker compose
# up -d postgres` from the repo root with POSTGRES_PASSWORD set). In
# production (see ../docker-compose.yml) this is set to the internal
# Docker network address instead.
DATABASE_URL=postgresql://ai_lawyer:ai_lawyer@localhost:5432/ai_lawyer

# Secret used by Auth.js to sign/encrypt session tokens. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=

# Only needed in production behind a reverse proxy (see
# ../docker-compose.yml) so Auth.js trusts the forwarded host. Leave
# unset for local dev.
# AUTH_TRUST_HOST=true
